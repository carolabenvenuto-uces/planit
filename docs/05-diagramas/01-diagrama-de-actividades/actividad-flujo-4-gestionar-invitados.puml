@startuml actividad-flujo-4-gestionar-invitados
title Flujo 4: Gestionar Lista de Invitados

|Usuario|
start
:Seleccionar opción 'Gestionar Invitados';
:Ingresar nombre del invitado y estado de asistencia (confirmado/pendiente/rechazado) vía prompt();

|Sistema|
if (¿Nombre no está vacío y estado es válido?) then (sí)
  :Evaluar si el invitado ya existe en la colección;
  
  if (¿El invitado ya existe?) then (sí)
    :Actualizar estado de asistencia del invitado existente;
  else (no)
    :Registrar nuevo invitado en la colección de invitados;
  endif
  
  :Inicializar contadores de 'Confirmados', 'Pendientes' y 'Rechazados' en 0;
  
  while (¿Quedan invitados por contabilizar en la colección?) is (sí)
    :Obtener estado del siguiente invitado de la lista;
    
    if (¿Asistencia es 'confirmado'?) then (sí)
      :Incrementar contador de confirmados;
    else if (¿Asistencia es 'pendiente'?) then (sí)
      :Incrementar contador de pendientes;
    else (sí)
      :Incrementar contador de rechazados;
    endif
  endwhile
  
  :Registrar estadísticas de asistencia en console.log();
  
  |Usuario|
  :Mostrar métricas de confirmados, pendientes y rechazados vía alert();
else (no)
  |Sistema|
  :Notificar datos de invitado inválidos;
  
  |Usuario|
  :Mostrar alerta de campos requeridos faltantes vía alert();
endif

stop
@enduml